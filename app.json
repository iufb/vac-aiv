{
  "expo": {
    "name": "Вакцинация в Казахстане",
    "slug": "vaccine-vq",
    "version": "3.0.0",
    "scheme": "vac-das",
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-localization",
      "expo-web-browser",
      "expo-build-properties",
      "react-native-edge-to-edge"
    ],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "orientation": "default",
    "icon": "./assets/images/adaptive-icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.iufb.vaccinevq",
      "bitcode": false,
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.gid.vacrk"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "27907568-eb39-4c5b-83a2-696f41a0bc7e"
      }
    }
  }
}
